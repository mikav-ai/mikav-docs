# ===========================================
# Mikav Docs - Environment Variables
# ===========================================
# Copy this file to .env.local for local development
# Never commit .env.local to version control!

# Site Configuration
# ------------------------------------------
SITE_URL=https://docs.mikav.in
BASE_URL=/

# Analytics (optional)
# ------------------------------------------
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# POSTHOG_API_KEY=phc_xxxxxxxxxxxx

# Search (optional - Algolia DocSearch)
# ------------------------------------------
# ALGOLIA_APP_ID=your_app_id
# ALGOLIA_API_KEY=your_search_api_key
# ALGOLIA_INDEX_NAME=mikav-docs

# API Documentation (optional)
# ------------------------------------------
# MIKAV_API_BASE_URL=https://api.mikav.in
# MIKAV_API_DOCS_TOKEN=your_docs_token

# Build Configuration
# ------------------------------------------
# NODE_ENV=development
# DISABLE_CACHE=false
